{
   "compilerOptions": {
      "target": "ES2017",
      "module": "commonjs",
      "moduleResolution": "node",
      "experimentalDecorators": true,
      "noImplicitThis": true,
      "noUnusedLocals": true,
      "stripInternal": true,
      "pretty": true,
      "declaration": true,
      "outDir": "dist",
      "lib": [
         "es2017",
         "dom"
      ],
      "sourceMap": true,
      "skipLibCheck": true,
      "types": [
         "node"
      ]
   },
   "exclude": [
      "dist",
      "node_modules",
      "test"
   ]
}